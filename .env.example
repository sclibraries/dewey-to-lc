# OCLC WorldCat Metadata API credentials (WSKey with the WorldCatMetadataAPI scope)
# Obtain from https://platform.worldcat.org/wskey/
WORLDCAT_CLIENT_ID=your_client_id_here
WORLDCAT_CLIENT_SECRET=your_client_secret_here

# Optional: loc.gov API does not require authentication
# but you can set a custom User-Agent for polite crawling
LOC_GOV_USER_AGENT=dewey-to-lc/0.1.0 (your-library@example.org)

# Rate limiting (requests per second)
WORLDCAT_RATE_LIMIT=1.0
LOC_GOV_RATE_LIMIT=2.0
